# .env.example — Colory
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite o .env.local no GitHub

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Gemini (Google AI) — funil
GEMINI_API_KEY=sua_gemini_api_key_aqui

# Kie.ai — app interno (reservado)
KIE_API_KEY=sua_kie_api_key_aqui

# Perfect Pay
PERFECTPAY_WEBHOOK_SECRET=seu_webhook_secret_aqui
NEXT_PUBLIC_PERFECTPAY_LINK_SEMANAL=https://perfectpay.com.br/pay/xxx
NEXT_PUBLIC_PERFECTPAY_LINK_ANUAL=https://perfectpay.com.br/pay/xxx
NEXT_PUBLIC_PERFECTPAY_LINK_OTO1=https://perfectpay.com.br/pay/xxx
NEXT_PUBLIC_PERFECTPAY_LINK_OTO2=https://perfectpay.com.br/pay/xxx
NEXT_PUBLIC_PERFECTPAY_LINK_OTO3=https://perfectpay.com.br/pay/xxx

# International Checkout Links (non-PT locales)
NEXT_PUBLIC_CHECKOUT_LINK_ANUAL_INTL=https://checkout-internacional.com/anual
NEXT_PUBLIC_CHECKOUT_LINK_MENSAL_INTL=https://checkout-internacional.com/mensal
NEXT_PUBLIC_CHECKOUT_LINK_OTO1_INTL=https://checkout-internacional.com/oto1
NEXT_PUBLIC_CHECKOUT_LINK_OTO3_INTL=https://checkout-internacional.com/oto3

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
